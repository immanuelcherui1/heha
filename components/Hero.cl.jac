"""Original vector illustration and marketplace introduction."""
def:pub Hero() -> JsxElement {
    return <section className="hero">
        <div className="hero-copy"><span className="eyebrow"><span className="live-dot"></span> A BETTER WAY TO MOVE IN KENYA</span><h1>New beginnings.<br/><em>Better moves.</em></h1><p>Your next chapter starts with the right crew. Compare company information, request quotations, and choose the option that suits your move.</p><div className="hero-points"><span>Company approval reviewed by the platform</span><span>✓ Quotes in Kenya shillings</span></div><div className="hero-proof"><div className="avatar-stack"><span>JK</span><span>AW</span><span>MO</span></div><div><strong>A marketplace for moving companies.</strong><small>A marketplace for independent movers.</small></div></div></div>
        <div className="hero-visual"><div className="visual-grid"></div><div className="visual-label">YOUR NEXT CHAPTER<br/><strong>is just around the corner.</strong></div><svg className="hero-illustration" viewBox="0 0 520 350" aria-label="Illustration of a moving truck with household boxes" role="img"><ellipse cx="268" cy="302" rx="210" ry="16" fill="#214b3f" opacity=".15"/><path d="M25 299h470" stroke="#476a49" strokeWidth="2"/><rect x="104" y="125" width="216" height="155" rx="12" fill="#f7f3e8"/><path d="M324 179h76l58 61v40H324z" fill="#eebd5b"/><path d="M338 192h51l36 40h-87z" fill="#245346"/><rect x="346" y="242" width="18" height="5" rx="2" fill="#245346"/><circle cx="158" cy="279" r="30" fill="#203f34"/><circle cx="398" cy="279" r="30" fill="#203f34"/><circle cx="158" cy="279" r="13" fill="#e5e5ce"/><circle cx="398" cy="279" r="13" fill="#e5e5ce"/><text x="152" y="217" fill="#245346" fontSize="58" fontWeight="800" fontFamily="sans-serif">heha</text><rect x="66" y="71" width="58" height="48" fill="#d4a66d"/><path d="M91 71v48" stroke="#f1d7ae" strokeWidth="12"/><rect x="137" y="71" width="80" height="53" fill="#eabd81"/><path d="M176 71v53" stroke="#f7dfb7" strokeWidth="12"/><path d="M228 124V83h63v41" fill="#cf9558"/><path d="M259 83v41" stroke="#edc99a" strokeWidth="10"/><path d="M43 299V184m0 70c-49-28-37-57-16-40m16 16c50-31 56-72 28-51" stroke="#547f50" strokeWidth="13" strokeLinecap="round" fill="none"/></svg><div className="floating-card"><span className="round-check">✓</span><div><strong>A fresh start, sorted.</strong><small>Your move. Your choice of mover.</small></div><span>↗</span></div><div className="visual-stamp">NAIROBI · NAKURU<br/>MOMBASA · KISUMU</div></div>
    </section>;
}
